<Project Sdk="Microsoft.NET.Sdk">
  <!-- Oracle service for the Oracle contract (docs/ORACLE.md). .NET 10, no database server, no paid data source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>zen-oracle</AssemblyName>
    <RootNamespace>Oracle</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Leaf.fs" />
    <Compile Include="Providers.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="NodeClient.fs" />
    <Compile Include="Body.fs" />
    <Compile Include="SelfTest.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Zulib" />
    <PackageReference Include="zen_secp256k1_linux" />
    <ProjectReference Include="..\Consensus\Consensus.fsproj" />
  </ItemGroup>
  <!-- Consensus serializes public keys with the native secp256k1 library: put it next to the program -->
  <Target Name="CopySecp256k1" AfterTargets="Build">
    <ItemGroup><_SecpLib Include="$(NuGetPackageRoot)zen_secp256k1_linux/**/libsecp256k1.so" /></ItemGroup>
    <Copy SourceFiles="@(_SecpLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_SecpLib)' != ''" />
    <Warning Text="libsecp256k1.so not found in the NuGet cache" Condition="'@(_SecpLib)' == ''" />
  </Target>
</Project>
