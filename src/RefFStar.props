<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- F* assemblies used in-process (hints, AST elaboration). fstar.exe itself runs as a separate Mono process. -->
  <ItemGroup>
    <PackageReference Include="ZFStar" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="fstar"><HintPath>$(PkgZFStar)/tools/fstar.exe</HintPath></Reference>
    <Reference Include="parser"><HintPath>$(PkgZFStar)/tools/parser.dll</HintPath></Reference>
    <Reference Include="prettyprint"><HintPath>$(PkgZFStar)/tools/prettyprint.dll</HintPath></Reference>
    <Reference Include="basic"><HintPath>$(PkgZFStar)/tools/basic.dll</HintPath></Reference>
  </ItemGroup>
</Project>
