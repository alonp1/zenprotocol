<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>Consensus</AssemblyName>
    <RootNamespace>Consensus</RootNamespace>
    <OtherFlags>--warnon:1182</OtherFlags>
