<Project>
  <!-- Shared settings for all projects: .NET 10 (stage 4 of docs/MIGRATION.md).
       Packages come from NuGet (src/Directory.Packages.props pins every version to paket.lock of release 1.0.13). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NU1701: .NET Framework-only packages (Zulib, FsBech32, ZFStar, ...) used on .NET 10 - checked by the replay test.
         NU1603/NU1605: exact pins from paket.lock. FS3370 etc: new compiler notes on old code. -->
    <NoWarn>$(NoWarn);NU1701;NU1603;NU1605;NU1608;NU1902;NU1903;NU1904;FS3370;FS0044;FS0064;FS3548</NoWarn>
    <WarningsAsErrors></WarningsAsErrors>
  </PropertyGroup>

  <!-- test projects: dotnet test with NUnit -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
</Project>
